# Copia a .env para desarrollo local (o configura estas variables en Dokploy)
PORT=3000
TALLER_NOMBRE=Taller Mecánico Pepe
DB_PATH=./data/taller.db
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave
# LOGIN_HINT=true muestra usuario y contraseña en la pantalla de login.
# Útil para enseñar la demo a un cliente; quítalo en producción real.
LOGIN_HINT=true
